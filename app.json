{
  "expo": {
    "name": "Cashbaq",
    "slug": "cashbaq",
    "scheme": "cashbaq",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "cover",
      "backgroundColor": "#0D7C5F"
    },
    "ios": {
      "bundleIdentifier": "com.cashbaq.app",
      "buildNumber": "1",
      "supportsTablet": false,
      "infoPlist": {
        "CFBundleDisplayName": "Cashbaq"
      }
    },
    "android": {
      "package": "com.cashbaq.app",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0D7C5F"
      }
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-font"
    ],
    "extra": {
      "eas": {
        "projectId": "32cc8607-6968-472c-a1b0-208c0276db2e"
      },
      "router": {}
    },
    "owner": "arnurio"
  }
}
