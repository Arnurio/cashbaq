{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "admin",
      "runtimeExecutable": "node",
      "runtimeArgs": ["admin/node_modules/vite/bin/vite.js", "admin", "--port", "5173"],
      "port": 5173
    },
    {
      "name": "landing",
      "runtimeExecutable": "npx",
      "runtimeArgs": ["serve", "landing", "-l", "4000"],
      "port": 4000
    },
    {
      "name": "expo-web-static",
      "runtimeExecutable": "npx",
      "runtimeArgs": ["serve", "dist", "-l", "3000"],
      "port": 3000
    },
    {
      "name": "expo-web",
      "runtimeExecutable": "npx",
      "runtimeArgs": ["expo", "start", "--web", "--port", "8081"],
      "port": 8081
    }
  ]
}
