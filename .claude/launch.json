{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "landing",
      "runtimeExecutable": "npx",
      "runtimeArgs": ["serve", "landing", "-l", "4000"],
      "port": 4000
    },
    {
      "name": "expo-web-static",
      "runtimeExecutable": "npx",
      "runtimeArgs": ["serve", "dist", "-l", "3000"],
      "port": 3000
    },
    {
      "name": "expo-web",
      "runtimeExecutable": "npx",
      "runtimeArgs": ["expo", "start", "--web", "--port", "8081"],
      "port": 8081
    },
    {
      "name": "admin",
      "runtimeExecutable": "cmd",
      "runtimeArgs": ["/c", "cd admin && npx vite --port 5173"],
      "port": 5173
    }
  ]
}
